DATABASE_URL=your-neon-connection-string
API_KEY=dev-key
DEV_MODE=true
# --- Alerting ---------------------------------------------------------------
# Error monitoring. Create a free Sentry project and paste its DSN here.
# Leave blank to disable (errors then go to Slack only, if configured).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Slack incoming-webhook URL — the default sink for ALL alerts. Create one at
# api.slack.com (Incoming Webhooks) for an #alerts channel. Unset => dropped.
SLACK_WEBHOOK_URL=
# Optional per-category overrides (each falls back to SLACK_WEBHOOK_URL):
# SLACK_WEBHOOK_ERRORS=
# SLACK_WEBHOOK_SECURITY=
# SLACK_WEBHOOK_PAYMENTS=
# SLACK_WEBHOOK_INTEREST=
# Dev-only session token signing (see api/auth.py) — replaced by Clerk later. Use a random value, never reuse across environments.
SESSION_SECRET=dev-secret-change-me
# Encrypts nfc_tags.aes_key_encrypted at rest (see api/services/nfc_crypto.py).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NFC_KEY_ENCRYPTION_SECRET=
# Optional. Leave unset — defaults to "require" (Neon needs SSL). Only CI
# sets this to "disable", to connect to its plain local Postgres container.
# DATABASE_SSL=disable
